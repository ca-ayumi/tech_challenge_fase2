# Copie este arquivo para .env e preencha os valores.
# cp .env.example .env

# ---------------------------------------------------------------------------
# Provedor de LLM: "gemini" (gratuito) ou "openai". Se ficar vazio, o sistema
# detecta automaticamente pela chave disponivel. Sem nenhuma chave, usa o
# gerador local (fallback), sem IA.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# --- Google Gemini (camada gratuita) ---
# Crie a chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...suachave...
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI (opcional; requer creditos pagos) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Semente para geracao reprodutivel de dados sinteticos (opcional)
SEED=42
